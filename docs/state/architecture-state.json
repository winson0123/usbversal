{
  "schema_version": 1,
  "updated_at": "2026-08-21T00:00:00Z",
  "allowed_patterns": [
    "adapter_per_vendor",
    "thin_cli",
    "asyncio_job_runner",
    "event_bus_in_process",
    "backup_before_write",
    "write_context_requires_backup_path",
    "domain_models_in_core",
    "storage_own_mount_and_backup",
    "unknown_field_preservation",
    "single_active_task_per_agent",
    "merge_never_regenerate_vendor_index",
    "audio_file_writes_require_explicit_optin"
  ],
  "forbidden_patterns": [
    "cli_business_logic",
    "write_without_backup",
    "schema_rebuild_wholesale",
    "adapter_imports_cli",
    "core_imports_vendor_sql_directly",
    "parallel_agent_tasks",
    "silent_drop_unknown_fields",
    "assume_schema_stable",
    "rmtree_vendor_library_dir",
    "write_audio_tags_without_backup"
  ],
  "constraints": {
    "language": "python",
    "min_python": "3.11",
    "lint": "ruff",
    "test": "pytest",
    "async": "asyncio",
    "packaging": "pyinstaller",
    "primary_test_mount": "/mnt/usb",
    "vendors": [
      "rekordbox",
      "serato"
    ],
    "metadata_only": true,
    "no_audio_processing": true,
    "audio_tag_writes": "stage_2_only_explicit_optin"
  },
  "layer_dependencies": {
    "cli": [
      "jobs",
      "core"
    ],
    "jobs": [
      "core",
      "storage",
      "adapters"
    ],
    "core": [],
    "adapters": [
      "core",
      "storage"
    ],
    "storage": [
      "core"
    ]
  },
  "known_layer_violations": [
    "app/jobs/* imports app.services.scan_service (declared deps: core, storage, adapters)",
    "app/services/migration_service.py imports serato_tools.database_v2 directly (vendor lib outside adapter layer)"
  ]
}
